# Secrets et states : jamais dans Git.
app/secrets/
*.key
*.pem
*.tfstate
*.tfstate.*
terraform.tfstate.d/
*.tfplan
.terraform/
ca-*.crt

# Archives d'images (docker save) : jamais dans Git.
*.tar

# Le kubeconfig écrit par le provider kind : la clé d'administration du
# cluster. Jamais dans Git.
infra/00-cluster/*-config

# Partie cloud : la clé SSH, le kubeconfig, la copie de infra/20-env.
# (Le state de la couche, terraform.tfstate, est déjà exclu plus haut.)
infra/00-cloud-hetzner/.cles/
infra/00-cloud-hetzner/.env-cloud/

# Les sauvegardes de la base (atelier 10) : elles contiennent des données
# personnelles. Jamais dans Git.
sauvegardes/

# Outils et éditeurs
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
rendu-*.yaml
